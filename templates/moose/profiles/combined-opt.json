        "Postprocessors", "VectorPostprocessors", "Outputs"
      ]
    }
  ],
  "mapping_registry": {
    "path": "../mapping-v1.json",
    "version": "1.0.0"
  },
  "check_command": "{solver} -i {input} --check-input",
